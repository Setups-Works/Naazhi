{
  "expo": {
    "name": "Naazhi",
    "slug": "untitled-project-mobile",
    "version": "7.7.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "untitled",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.setupsworks.naazhi",
      "supportsTablet": true
    },
    "android": {
      "package": "com.setupsworks.naazhi",
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 8
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          { "name": "Night", "ios": "./assets/icons/night.png", "android": { "foregroundImage": "./assets/icons/night-foreground.png", "backgroundColor": "#242424" } },
          { "name": "Original", "ios": "./assets/icons/original.png", "android": { "foregroundImage": "./assets/icons/original-foreground.png", "backgroundColor": "#f9f4e5" } },
          { "name": "Forest", "ios": "./assets/icons/forest.png", "android": { "foregroundImage": "./assets/icons/forest-foreground.png", "backgroundColor": "#235340" } },
          { "name": "Clay", "ios": "./assets/icons/clay.png", "android": { "foregroundImage": "./assets/icons/clay-foreground.png", "backgroundColor": "#b9614f" } }
        ]
      ],
      ["expo-audio", { "enableBackgroundPlayback": false }],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Naazhi reads your steps, distance, active energy, heart rate and sleep so you can see them in your workspace and ask the assistant about them.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TasksWidget",
              "displayName": "Today’s tasks",
              "description": "Your to-dos for today",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            },
            {
              "name": "QuickWidget",
              "displayName": "Quick write",
              "description": "Start a journal entry, note or task",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "HealthWidget",
              "displayName": "Health today",
              "description": "Steps and more from Health",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "JournalWidget",
              "displayName": "Journal",
              "description": "Your latest entry and writing streak",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TasksWidget",
              "label": "Today’s tasks",
              "description": "Your to-dos for today",
              "previewImage": "./assets/widgets/tasks.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickWidget",
              "label": "Quick write",
              "description": "Start a journal entry, note or task",
              "previewImage": "./assets/widgets/quick.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "HealthWidget",
              "label": "Health today",
              "description": "Steps and more from Health",
              "previewImage": "./assets/widgets/health.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "JournalWidget",
              "label": "Journal",
              "description": "Your latest entry and writing streak",
              "previewImage": "./assets/widgets/journal.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidWorkRuntimeFix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
