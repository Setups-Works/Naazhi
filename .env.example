# Copy to .env.local and fill in. Never commit real values. Secrets must NEVER start with NEXT_PUBLIC_.
# Everything runs in Docker:  cp .env.selfhost.example .env.selfhost  &&  docker compose --env-file .env.selfhost up -d
# Then use the SAME passwords below (host ports are bound to 127.0.0.1 only).

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:<POSTGRES_PASSWORD>@127.0.0.1:5432/untitled

# ── Redis (sessions/rate limits/cache) ──────────────────────────────────────────────
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# ── Object storage (S3 API: SeaweedFS in Docker; MinIO, Garage or AWS S3 also work) ─
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=untitled
S3_SECRET_KEY=<S3_SECRET_KEY>
# R2 uses S3_REGION=auto. Set false when using a bucket-scoped token and pre-created buckets.
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKETS=true
# Azure Blob Storage instead of S3: set the storage account's connection string (the S3_* values above are then ignored).
# AZURE_STORAGE_CONNECTION_STRING=<AZURE_STORAGE_CONNECTION_STRING>

# ── Auth (Better Auth) ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
BETTER_AUTH_SECRET=<random secret, 32+ chars>
# Public URL of this deployment; used in email links and OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Needed when using Expo Go against a deployed server; custom native builds use the `untitled://` app scheme.
BETTER_AUTH_TRUSTED_ORIGINS=exp://**
# Optional extra WebAuthn origins, comma separated (for example Android app signing hashes).
PASSKEY_ORIGINS=
# Optional "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set to "false" to let people sign in without confirming their email (not recommended in production).
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# ── Email ───────────────────────────────────────────────────────────────────────────
# Dev: Mailpit catches everything at http://localhost:8025. Production: your SMTP server, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM="Naazhi <no-reply@yourdomain.com>"

# ── Admin bootstrap ─────────────────────────────────────────────────────────────────
# Comma-separated emails that are always admins. More admins can be promoted from /admin/users.
ADMIN_EMAILS=you@example.com

# ── Site ────────────────────────────────────────────────────────────────────────────
# Public URL of this deployment (used for absolute links). Optional locally. In production set it: without it the sitemap is empty
# and the structured data (schema.org) leaves out its URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search-console ownership (optional). Paste the token from Google Search Console / Bing Webmaster Tools; they are public meta tags, not secrets.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Website and app on separate hosts (one deployment, both hostnames pointing at it). Leave all of these out to serve everything from one host.
#   NEXT_PUBLIC_SITE_URL=https://naazhi.app            the website (landing pages)
#   NEXT_PUBLIC_APP_URL=https://dashboard.naazhi.app         the app (dashboard, sign-in, API)
#   BETTER_AUTH_URL=https://dashboard.naazhi.app             auth lives on the app host (also the Google redirect and passkey domain)
#   AUTH_COOKIE_DOMAIN=naazhi.app                      share the sign-in cookie so the website can show "Dashboard" when signed in
#   EXPO_PUBLIC_API_URL=https://dashboard.naazhi.app         the Android app's API address (apps/mobile/.env.local)

# ── AI & integrations (Phases 3–4) — not used yet ────────────────────────────────────
# Chat replies (https://console.groq.com/keys). Without it the chat runs as "No AI". GROQ_MODEL is optional (default llama-3.3-70b-versatile).
# GROQ_API_KEY=
# GROQ_MODEL=
# COMPOSIO_API_KEY=

# ── Background jobs (Phase 1) ───────────────────────────────────────────────────────
# Protects /api/v1/jobs/*.
# CRON_SECRET=

# Push notifications to Android phones: the Firebase service-account JSON (plain or base64). Optional: without it messages only reach the in-app inbox.
# FCM_SERVICE_ACCOUNT=

# ── Jira helper for developers + AI agents (scripts/jira/jira.mjs, docs/AI_WORKFLOW.md) ──
# YOUR OWN token from https://id.atlassian.com/manage-profile/security/api-tokens. Local only — never commit, never paste into chats.
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_BASE_URL=https://setups-works.atlassian.net
